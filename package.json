{
  "name": "yanglab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Three practical workspaces for Nguyen Hong Giang: meeting actions, content planning and API contracts.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite server.mjs",
