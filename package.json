    "test:ui": "node --experimental-sqlite --test test/browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
