{
  "name": "yangdata",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Private CSV datasets and a parameterized SQLite report builder.",
  "scripts": {
    "start": "node --experimental-sqlite server.mjs",
    "test": "node --experimental-sqlite --test test/*.test.mjs",
    "test:ui": "node --experimental-sqlite --test test/browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
